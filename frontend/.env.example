# Base URL for the backend REST API (note the /api suffix — routes are mounted there)
VITE_API_BASE_URL=http://localhost:5000/api

# Base URL for the realtime / websocket server (notifications, video-consult signaling)
VITE_SOCKET_URL=http://localhost:5000

# When "true", Mock Service Worker intercepts API calls and serves fixture data.
# Flip to "false" once the real backend endpoints are available — no code changes needed.
VITE_USE_MOCKS=true
